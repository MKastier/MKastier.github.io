---
import Layout from '../layouts/Layout.astro';

const navLinks = [
  { id: 'home', label: 'Home', icon: 'M3 11l9-8 9 8M5 10v10h14V10' },
  { id: 'projects', label: 'Projects', icon: 'M8 7l-5 5 5 5M16 7l5 5-5 5' },
  { id: 'skills', label: 'Skills', icon: 'M13 10V3L4 14h7v7l9-11h-7z' },
  { id: 'contact', label: 'Contact', icon: 'M3 7l9 6 9-6M5 5h14a2 2 0 012 2v10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2z' },
];

const skills = [
  {
    title: 'Frontend & Web',
    icon: 'M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4',
    items: [
      ['HTML', 'bg-orange-400'], ['CSS (Tailwind)', 'bg-sky-400'], ['JavaScript', 'bg-yellow-300'],
      ['React & Astro (Basics)', 'bg-cyan-300'], ['PHP (Basics)', 'bg-indigo-300'],
    ],
  },
  {
    title: 'Backend & Engineering',
    icon: 'M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01',
    items: [['Python (Flask)', 'bg-emerald-400'], ['C#', 'bg-purple-400'], ['Node.js', 'bg-green-400']],
  },
  {
    title: 'Database Management',
    icon: 'M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4',
    items: [['Relational Databases', 'bg-teal-300'], ['PostgreSQL', 'bg-blue-300'], ['Queries', 'bg-amber-300'], ['Data Structures', 'bg-blue-400']],
  },
  {
    title: 'Design & Developer Tools',
    icon: 'M12 6V4m0 16v-2m6-6h2M4 12h2m10.95-4.95l1.4-1.4M5.65 18.35l1.4-1.4m0-9.9l-1.4-1.4m12.7 12.7l-1.4-1.4M15 12a3 3 0 11-6 0 3 3 0 016 0z',
    items: [['Git & GitHub', 'bg-orange-400'], ['Docker (Beginner)', 'bg-blue-300'], ['Canva', 'bg-purple-300'], ['MS Office 365', 'bg-red-400']],
  },
];
---

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Antonio:wght@100;200;300&family=Inter:wght@400;500;600;800&display=swap" rel="stylesheet" />

<Layout>

    <!-- HOME -->
    <section id="home" class="relative w-full min-h-screen flex items-center overflow-hidden bg-linear-to-b from-[#061c1a] via-[#0b2f2b] to-[#12423c] py-32 lg:py-0">

        <div class="mist absolute -top-40 -left-40 w-150 h-150 rounded-full bg-teal-400/20 blur-[130px] pointer-events-none"></div>
        <div class="mist absolute -bottom-52 right-[10%] w-175 h-175 rounded-full bg-emerald-300/15 blur-[140px] pointer-events-none"></div>

        <div aria-hidden="true" class="display absolute inset-x-0 top-[14%] lg:top-[12%] text-center font-extralight leading-none tracking-wide text-white/10 select-none pointer-events-none text-[24vw] lg:text-[17vw]">
            DEVELOPER
        </div>

        <div class="max-w-6xl mx-auto px-6 w-full relative z-10">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
                <div class="lg:col-span-7 flex flex-col items-start order-2 lg:order-1">
                    <h1 class="text-white font-extrabold tracking-tight leading-[1.08] text-4xl sm:text-5xl lg:text-6xl xl:text-[4.2rem] mb-6">
                        Hi, I'm Majro.<br />
                        <span class="whitespace-nowrap text-teal-100">
                            <span id="typewriter"></span><span class="animate-pulse">|</span>
                        </span>
                    </h1>

                    <p class="text-base sm:text-lg text-white/80 max-w-lg mb-9 leading-relaxed font-normal">
                        I connect robust backend logic with clean, modern web interfaces. Focused on data architecture, scalability, and building digital products that last.
                    </p>

                    <div class="flex flex-wrap items-center gap-3">
                        <a href="#projects" class="px-7 py-3.5 bg-white text-slate-900 font-semibold rounded-full text-sm transition hover:bg-teal-50 hover:shadow-xl">
                            Check out my projects
                        </a>
                        <a href="#contact" class="glass px-7 py-3.5 text-white font-semibold rounded-full text-sm transition hover:bg-white/20">
                            Get in touch
                        </a>
                    </div>
                </div>

                <div class="lg:col-span-5 relative flex justify-center order-1 lg:order-2">
                    
                    <div class="relative w-full max-w-75 sm:max-w-sm aspect- rounded overflow-hidden shadow-2xl ring-1 ring-white/30">
                        <img src="/me.png" alt="Majro" class="w-full h-full object-cover" />
                        <div class="absolute inset-0 bg-linear-to-t from-[#061c1a]/60 via-transparent to-transparent"></div>
                    </div>

                </div>
            </div>
        </div>
    </section>

    <!-- PROJECTS -->
    <section id="projects" class="relative w-full min-h-screen flex items-center overflow-hidden bg-linear-to-b from-[#12423c] via-[#164e47] to-[#12423c] py-28">
        <div class="mist absolute top-1/3 -left-40 w-120 h-120 rounded-full bg-teal-300/15 blur-[120px] pointer-events-none"></div>
        <div class="max-w-6xl mx-auto px-6 w-full relative z-10">
            <h2 class="text-4xl md:text-5xl font-black text-white mb-10 tracking-tight">My Projects</h2>
            <div class="glass rounded-3xl p-8 md:p-10 max-w-xl">
                <p class="text-white/80 text-lg">In process…</p>
            </div>
        </div>
    </section>

    <!-- SKILLS -->
    <section id="skills" class="relative w-full min-h-screen flex justify-center items-center overflow-hidden bg-linear-to-b from-[#12423c] via-[#0f3833] to-[#0b2f2b] py-28">
        <div class="mist absolute bottom-0 -right-40 w-150 h-150 rounded-full bg-emerald-300/15 blur-[130px] pointer-events-none"></div>

        <div class="max-w-4xl mx-auto px-6 w-full flex flex-col items-center relative z-10">

            <div class="text-center mb-14">
                <h2 class="text-4xl md:text-5xl font-black text-white mb-4 tracking-tight">My Skills</h2>
                <p class="text-white/70 max-w-md mx-auto text-lg">From database architecture to clean user interfaces – the tools behind my code.</p>
            </div>

            <div class="w-full flex flex-col gap-5">
                {skills.map((s) => (
                    <div class="skill-card glass rounded-3xl overflow-hidden transition-all duration-300 cursor-pointer hover:border-teal-200/40">
                        <div class="skill-header flex items-center justify-between p-6 md:p-7" role="button" tabindex="0" aria-expanded="false">
                            <div class="flex items-center gap-5">
                                <div class="w-14 h-14 bg-white/10 rounded-2xl flex items-center justify-center text-teal-200 border border-white/20">
                                    <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={s.icon}></path></svg>
                                </div>
                                <h3 class="text-xl md:text-2xl font-bold text-white">{s.title}</h3>
                            </div>
                            <div class="chevron text-white/60 transition-transform duration-300">
                                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                            </div>
                        </div>

                        <div class="skill-content grid grid-rows-[0fr] opacity-0 transition-all duration-300 ease-in-out">
                            <div class="overflow-hidden">
                                <div class="p-6 md:p-7 pt-5 border-t border-white/15 flex flex-wrap gap-3">
                                    {s.items.map(([name, dot]) => (
                                        <div class="px-4 py-2 bg-white/10 border border-white/20 rounded-full text-white font-medium text-sm flex items-center gap-2">
                                            <span class={`w-2 h-2 rounded-full ${dot}`}></span>{name}
                                        </div>
                                    ))}
                                </div>
                            </div>
                        </div>
                    </div>
                ))}
            </div>
        </div>
    </section>

    <!-- CONTACT -->
    <section id="contact" class="relative w-full min-h-screen flex justify-center items-center overflow-hidden bg-linear-to-b from-[#0b2f2b] via-[#082421] to-[#061c1a] py-28">
        <div class="mist absolute -top-32 left-1/4 w-150 h-150 rounded-full bg-teal-400/20 blur-[140px] pointer-events-none"></div>

        <div class="max-w-4xl mx-auto px-6 w-full flex flex-col items-center relative z-10">

            <div class="text-center mb-10">
                <h2 class="text-4xl md:text-5xl font-black text-white mb-4 tracking-tight">Get In Touch</h2>
                <p class="text-white/75 max-w-md mx-auto text-lg">
                    My inbox is always open. Whether you have a question or just want to say hi, I'll try my best to get back to you!
                </p>
            </div>

            <div class="glass w-full max-w-lg rounded p-8 md:p-10">
                <form id="contact-form" class="flex flex-col gap-5">
                    <input type="hidden" name="access_key" value="60a11a4c-0475-4e69-805a-295f21f2c550" />

                    <div>
                        <label for="name" class="block text-sm font-semibold text-white/90 mb-2">Name</label>
                        <input type="text" id="name" name="name" placeholder="Enter your name" required class="field" />
                    </div>
                    <div>
                        <label for="email" class="block text-sm font-semibold text-white/90 mb-2">E-mail</label>
                        <input type="email" id="email" name="email" placeholder="Enter your email" required class="field" />
                    </div>
                    <div>
                        <label for="message" class="block text-sm font-semibold text-white/90 mb-2">Message</label>
                        <textarea id="message" name="message" rows="5" placeholder="Hi, I'd like to talk about..." required class="field resize-none"></textarea>
                    </div>

                    <button id="submit-btn" type="submit"
                        class="mt-2 w-full py-4 bg-white text-slate-900 font-bold rounded-full transition hover:bg-teal-50 hover:shadow-xl disabled:opacity-60 cursor-pointer">
                        Send Message
                    </button>
                </form>
            </div>
        </div>

        <div id="result-popup" class="fixed inset-0 z-100 flex items-center justify-center bg-black/60 backdrop-blur-md opacity-0 pointer-events-none transition-opacity duration-300">
            <div id="popup-card" class="glass-dark rounded-3xl p-8 max-w-sm w-full mx-6 transform scale-95 transition-transform duration-300 text-center border border-white/20">
                <div id="popup-icon-success" class="w-16 h-16 mx-auto bg-teal-500/20 text-teal-300 rounded-full flex items-center justify-center mb-4 border border-teal-500/30">
                    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
                </div>
                <div id="popup-icon-error" class="w-16 h-16 mx-auto bg-red-500/20 text-red-400 rounded-full flex items-center justify-center mb-4 border border-red-500/30">
                    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M6 18L18 6M6 6l12 12"></path></svg>
                </div>
                <h3 id="popup-title" class="text-2xl font-black text-white mb-2">Title</h3>
                <p id="popup-message" class="text-white/70 mb-8 font-medium">Message goes here.</p>
                <button id="close-popup" class="w-full py-3 bg-white text-slate-900 font-bold rounded-full transition hover:bg-teal-50 cursor-pointer">Close</button>
            </div>
        </div>
    </section>

    <script is:inline>
        const form = document.getElementById('contact-form');
        const submitBtn = form?.querySelector('button[type="submit"]');
        const popup = document.getElementById('result-popup');
        const popupCard = document.getElementById('popup-card');
        const closePopupBtn = document.getElementById('close-popup');
        const popupTitle = document.getElementById('popup-title');
        const popupMessage = document.getElementById('popup-message');
        const iconSuccess = document.getElementById('popup-icon-success');
        const iconError = document.getElementById('popup-icon-error');

        if (form) {
            form.addEventListener('submit', async function (e) {
                e.preventDefault();
                const originalBtnText = submitBtn.innerText;
                submitBtn.innerText = 'Sending...';
                submitBtn.disabled = true;
                const formData = new FormData(form);
                try {
                    const response = await fetch('https://api.web3forms.com/submit', {
                        method: 'POST',
                        headers: { 'Accept': 'application/json' },
                        body: formData
                    });
                    const data = await response.json();
                    if (response.status === 200) {
                        showPopup('Message Sent!', 'Thank you for reaching out. I will get back to you as soon as possible.', true);
                        form.reset();
                    } else {
                        showPopup('Oops!', data.message || 'Something went wrong. Please try again later.', false);
                    }
                } catch (error) {
                    showPopup('Error', 'Unable to send message. Please check your internet connection.', false);
                } finally {
                    submitBtn.innerText = originalBtnText;
                    submitBtn.disabled = false;
                }
            });
        }

        function showPopup(title, message, isSuccess) {
            popupTitle.innerText = title;
            popupMessage.innerText = message;
            iconSuccess.classList.toggle('hidden', !isSuccess);
            iconError.classList.toggle('hidden', isSuccess);
            popup.classList.remove('opacity-0', 'pointer-events-none');
            popupCard.classList.remove('scale-95');
            popupCard.classList.add('scale-100');
        }

        if (closePopupBtn) {
            closePopupBtn.addEventListener('click', () => {
                popup.classList.add('opacity-0', 'pointer-events-none');
                popupCard.classList.remove('scale-100');
                popupCard.classList.add('scale-95');
            });
        }

        document.querySelectorAll('.skill-card').forEach(card => {
            const header = card.querySelector('.skill-header');
            const content = card.querySelector('.skill-content');
            const chevron = card.querySelector('.chevron');

            const toggle = () => {
                const isOpen = content.classList.contains('grid-rows-[1fr]');
                content.classList.toggle('grid-rows-[1fr]', !isOpen);
                content.classList.toggle('opacity-100', !isOpen);
                content.classList.toggle('grid-rows-[0fr]', isOpen);
                content.classList.toggle('opacity-0', isOpen);
                chevron.classList.toggle('rotate-180', !isOpen);
                header.setAttribute('aria-expanded', String(!isOpen));
            };

            header.addEventListener('click', toggle);
            header.addEventListener('keydown', (e) => {
                if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); toggle(); }
            });
        });

        document.addEventListener('DOMContentLoaded', () => {
            const navLinks = document.querySelectorAll('[data-nav]');
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (!entry.isIntersecting) return;
                    navLinks.forEach(a => {
                        const active = a.dataset.nav === entry.target.id;
                        a.classList.toggle('bg-white/20', active);
                        a.classList.toggle('text-white', active);
                    });
                });
            }, { threshold: 0.5 });
            document.querySelectorAll('section[id]').forEach(s => observer.observe(s));

            const typewriterText = document.getElementById('typewriter');
            if (typewriterText) {
                const phrases = ["WEB Developer", "Freelancer", "Database Manager"];
                let phraseIndex = 0;
                let charIndex = 0;
                let isDeleting = false;

                function type() {
                    const currentPhrase = phrases[phraseIndex];
                    if (isDeleting) {
                        typewriterText.textContent = currentPhrase.substring(0, charIndex - 1);
                        charIndex--;
                    } else {
                        typewriterText.textContent = currentPhrase.substring(0, charIndex + 1);
                        charIndex++;
                    }
                    let typeSpeed = isDeleting ? 50 : 100;
                    if (!isDeleting && charIndex === currentPhrase.length) {
                        typeSpeed = 3000;
                        isDeleting = true;
                    } else if (isDeleting && charIndex === 0) {
                        isDeleting = false;
                        phraseIndex = (phraseIndex + 1) % phrases.length;
                        typeSpeed = 300;
                    }
                    setTimeout(type, typeSpeed);
                }
                setTimeout(type, 1000);
            }
        });
    </script>
</Layout>