---
interface Props { lang?: 'en' | 'sk'; }

const { lang = 'en' } = Astro.props;

const text = {
    en: {
        home: "Home",
        about: "About",
        projects: "Projects",
        skills: "Skills",
        contact: "Contact",
        cv: "Download CV",
        switchUrl: "/sk",
        switchLabel: "🇸🇰 SK" 
    },
    sk: {
        home: "Domov",
        about: "O mne",
        projects: "Projekty",
        skills: "Zručnosti",
        contact: "Kontakt",
        cv: "Stiahnuť Životopis",
        switchUrl: "/",
        switchLabel: "🇬🇧 EN"
    }
};

const t = text[lang as keyof typeof text] || text.en;
---

<header class="sticky top-0 z-50 w-full bg-white/40 backdrop-blur-md border-b border-white/20 shadow-sm transition-all">
    <div class="max-w-6xl mx-auto px-6 py-4 flex justify-between items-center">
      
      <a href="#home" class="z-50 relative flex items-center">
        <img 
            src="/logo.png" 
            alt="Moje Logo" 
            class="h-10 md:h-11 w-auto object-contain"
        >
    </a>
  
      <nav class="hidden md:flex items-center gap-8 font-medium text-slate-600">
        <a href="#home" class="nav-link hover:text-[#0f766e] hover:underline hover:decoration-2 hover:decoration-[#0f766e] hover:underline-offset-8 transition-all">{t.home}</a>
        <a href="#about" class="nav-link hover:text-[#0f766e] hover:underline hover:decoration-2 hover:decoration-[#0f766e] hover:underline-offset-8 transition-all">{t.about}</a>
        <a href="#projects" class="nav-link hover:text-[#0f766e] hover:underline hover:decoration-2 hover:decoration-[#0f766e] hover:underline-offset-8 transition-all">{t.projects}</a>
        <a href="#skills" class="nav-link hover:text-[#0f766e] hover:underline hover:decoration-2 hover:decoration-[#0f766e] hover:underline-offset-8 transition-all">{t.skills}</a>
        <a href="#contact" class="nav-link hover:text-[#0f766e] hover:underline hover:decoration-2 hover:decoration-[#0f766e] hover:underline-offset-8 transition-all">{t.contact}</a>
      </nav>
  
        <a href="/CV.pdf" target="_blank" class="hidden md:inline-block bg-[#0f766e] hover:bg-[#0b5c56] text-white px-5 py-2.5 
            rounded-lg font-semibold transition-all shadow-sm z-50 relative">{t.cv}</a>

            <a href={t.switchUrl} class="px-3 py-1 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg font-bold transition-colors">
              {t.switchLabel}
            </a>
        
        <button id="menu-btn" class="md:hidden z-50 relative flex flex-col gap-1.25 p-2 focus:outline-none">
            <div class="w-6 h-0.5 bg-black transition-all duration-300 origin-left" id="line1"></div>
            <div class="w-6 h-0.5 bg-black transition-all duration-300" id="line2"></div>
            <div class="w-6 h-0.5 bg-black transition-all duration-300 origin-left" id="line3"></div>
        </button>
    </div>
</header>

    <div id="mobile-menu" class="fixed inset-0 bg-white flex flex-col items-center justify-center pb-32 gap-8 text-xl font-semibold opacity-0 pointer-events-none transition-opacity duration-300 z-40">
        <a href="#home" class="mobile-link hover:text-[#0f766e] transition-colors">Home</a>
        <a href="#about" class="mobile-link hover:text-[#0f766e] transition-colors">About</a>
        <a href="#projects" class="mobile-link hover:text-[#0f766e] transition-colors">Projects</a>
        <a href="#skills" class="mobile-link hover:text-[#0f766e] transition-colors">Skills</a>
        <a href="#contact" class="mobile-link hover:text-[#0f766e] transition-colors">Contact</a>
        <a href="/CV.pdf" target="_blank" class="mobile-link bg-[#0f766e] hover:bg-[#0b5c56] text-white px-8 py-3 mt-4 rounded-lg shadow-md transition-all">
          Download CV
        </a>
    </div>
  
  <script>
    const btn = document.getElementById('menu-btn')!;
    const menu = document.getElementById('mobile-menu')!;
    const links = document.querySelectorAll('.mobile-link');
    const line1 = document.getElementById('line1')!;
    const line2 = document.getElementById('line2')!;
    const line3 = document.getElementById('line3')!;
  
    let isMenuOpen = false;
  
    function toggleMenu() {
      isMenuOpen = !isMenuOpen;
      
      if (isMenuOpen)
      {
        menu.classList.remove('opacity-0', 'pointer-events-none');
        menu.classList.add('opacity-100', 'pointer-events-auto');
        
        line1.classList.add('rotate-45', 'translate-x-[2px]', '-translate-y-[2px]');
        line2.classList.add('opacity-0');
        line3.classList.add('-rotate-45', 'translate-x-[2px]', 'translate-y-[2px]');
        
        document.body.style.overflow = 'hidden';
      } 
      else
      {
        menu.classList.remove('opacity-100', 'pointer-events-auto');
        menu.classList.add('opacity-0', 'pointer-events-none');
        
        line1.classList.remove('rotate-45', 'translate-x-[2px]', '-translate-y-[2px]');
        line2.classList.remove('opacity-0');
        line3.classList.remove('-rotate-45', 'translate-x-[2px]', 'translate-y-[2px]');
        
        document.body.style.overflow = 'auto';
      }
    }
  
    btn.addEventListener('click', toggleMenu);
  
    links.forEach(link => {
      link.addEventListener('click', () => {
        if (isMenuOpen) toggleMenu();
      });
    });


  const sections = document.querySelectorAll('section');
  const navLinksDesktop = document.querySelectorAll('.nav-link');
  
  const activeClasses = ['text-[#0f766e]', 'underline', 'decoration-2', 'decoration-[#0f766e]', 'underline-offset-8'];

  window.addEventListener('scroll', () => {
    let current = '';

    sections.forEach(section => {
      const sectionTop = section.offsetTop;
      if (scrollY >= sectionTop - 150) {
        current = section.id;
      }
    });

    navLinksDesktop.forEach(link => {
      link.classList.remove(...activeClasses);
      
      if (link.getAttribute('href') === `#${current}`) {
        link.classList.add(...activeClasses);
      }
    });
  });

  window.addEventListener('resize', () => {
    if (window.innerWidth >= 768 && isMenuOpen) {
      toggleMenu();
    }
  });
</script>